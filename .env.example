# Copy to .env and replace the password placeholder for your local installation.
# These values are examples only and are not credentials for a shared environment.
ENVIRONMENT=development
DEBUG=true

# Native PostgreSQL connection used by the ARC application
DATABASE_URL=postgresql+psycopg://arc_user:replace_with_local_password@localhost:5432/arc_dev
TEST_DATABASE_URL=postgresql+psycopg://arc_user:replace_with_local_password@localhost:5432/arc_test

# Razorpay Test Mode API credentials used only for authoritative read requests.
# Generate private values in the Razorpay Dashboard; never commit real keys.
RAZORPAY_KEY_ID=rzp_test_replace_with_key_id
RAZORPAY_KEY_SECRET=replace_with_test_key_secret
RAZORPAY_API_BASE_URL=https://api.razorpay.com

# Razorpay webhook signing secret (not the Razorpay API key secret)
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret
# Optional during secret rotation so older retried events can still be verified
RAZORPAY_WEBHOOK_PREVIOUS_SECRET=

# Optional Docker Compose PostgreSQL settings; keep these aligned with DATABASE_URL
POSTGRES_DB=arc_dev
POSTGRES_USER=arc_user
POSTGRES_PASSWORD=replace_with_local_password
